# ==============================================================================
# 8090 专属通道 (Scopus & Web of Science) 每日自动化采集系统配置文件模板
# 复制本文件为 .env 并填入真实配置（.env 已在 .gitignore 中排除，严禁提交至 Git）
# ==============================================================================

# 1. 8090 查重/学术平台专属账号与入口标识
CHANNEL_8090_USER=your_8090_username
CHANNEL_8090_PWD=your_8090_password
SCOPUS_GOTO_ID=2350
WOS_ENTRY_ID=5157

# 2. 12395 二级机构网关认证账号（若部分节点弹出二级表单时使用）
GATEWAY_12395_USER=your_12395_username
GATEWAY_12395_PWD=your_12395_password

# 3. 本地 Chrome/Edge 浏览器 CDP 远程调试与持久化配置（推荐使用 Chrome 避免 Edge SmartScreen 拦截 8090 域名）
CDP_URL=http://127.0.0.1:9222
EDGE_BINARY_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
EDGE_USER_DATA_DIR=E:\chrome_dev_profile
BROWSER_DOWNLOADS_DIR=C:\Users\Administrator\Downloads

# 4. 阿里云 RDS MySQL 生产数据库配置
MYSQL_HOST=rm-bp1399dnxr64wi5q2zo.mysql.rds.aliyuncs.com
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=qiyan_literature_collection
MYSQL_DSN=mysql://your_mysql_user:your_mysql_password@rm-bp1399dnxr64wi5q2zo.mysql.rds.aliyuncs.com:3306/qiyan_literature_collection

# 5. 本地数据落盘、断点续传与对账账本路径
DATA_ROOT_DIR=F:\pubmed
SCOPUS_DATA_DIR=F:\pubmed\scopus
SCOPUS_RAW_CSV_DIR=F:\pubmed\scopus\raw_csv
SCOPUS_LEDGER_PATH=F:\pubmed\scopus\scopus_day_ledger.json
WOS_DATA_DIR=F:\pubmed\wos
WOS_RAW_XLS_DIR=F:\pubmed\wos\raw_scihuber
WOS_LEDGER_PATH=F:\pubmed\wos\wos_day_ledger_ld.json
LOG_DIR=E:\harvest_standalone\logs

# 6. Windows 每日 08:00 自动计划任务名称
SCHEDULED_TASK_NAME=Daily_8AM_Scopus_WoS_Goal_Harvester
